# Copy to .env at the repo root. Every key is optional: anything missing => mock fallback.

# LLM (agent brains, OpenAI API, cheap models). Missing => scripted heuristic brains.
OPENAI_API_KEY=

# Archil disks + sandboxes. Missing => local in-memory disks.
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1

# Web search for crewmates + referee. Cascade: KEENABLE > LINKUP > EXA > TAVILY > canned mock results.
# Without KEENABLE_API_KEY, Keenable's public endpoint is tried before mock.
KEENABLE_API_KEY=
LINKUP_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=

# Force mock mode for everything even if keys are present (1 = on).
SUSAGENT_MOCK=0

# Server
PORT=4000
AUTO_START=1
AGENT_COUNT=12
# Balance knob: chance (0..1) an impostor gets a vague hint from one crew answer. Higher = harder for crew.
IMPOSTOR_WHISPER_CHANCE=0.5

# Web viewer
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
